{
  "name": "qinban-piano-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "predev": "node scripts/require-node.mjs",
    "dev": "node scripts/dev.mjs",
    "prebuild": "node scripts/require-node.mjs",
    "build": "node scripts/prepare-assets.mjs && vite build",
    "prestart": "node scripts/require-node.mjs",
    "start": "node server.mjs",
    "launch": "node scripts/launch.mjs",
    "pretest": "node scripts/require-node.mjs",
    "test": "node --test tests/*.test.mjs",
    "ai:check": "node scripts/ai-check.mjs",
    "omr:setup": "node scripts/setup-audiveris.mjs",
    "scores:add": "node scripts/score-repo.mjs add",
    "prescores:verify": "node scripts/require-node.mjs",
    "scores:verify": "node scripts/score-repo.mjs verify",
    "scores:list": "node scripts/score-repo.mjs list",
    "scores:reread-five": "node scripts/reread-five-high.mjs",
    "scores:index": "node scripts/score-repo.mjs index",
    "prebuild:pages": "node scripts/require-node.mjs",
    "build:pages": "node scripts/prepare-assets.mjs && VITE_STATIC_SITE=1 vite build --base ${PAGES_BASE:-/Open_Piano_Player/} --outDir dist-pages",
    "cloud:prepare": "node scripts/prepare-cloud-library.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run scores:verify",
    "prebuild:hosted": "node scripts/require-node.mjs",
    "build:hosted": "node scripts/prepare-assets.mjs && VITE_HOSTED_SITE=1 vite build --outDir dist-hosted",
    "accounts:start": "node scripts/accounts.mjs start",
    "accounts:invite": "node scripts/accounts.mjs invite",
    "commercial:build": "npm run build:hosted",
    "commercial:start": "node scripts/accounts.mjs start",
    "commercial:operator": "node scripts/accounts.mjs operator",
    "accounts:operator": "node scripts/accounts.mjs operator"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@electric-sql/pglite": "0.5.10",
    "@napi-rs/canvas": "1.0.11",
    "@neteasecloudmusicapienhanced/api": "4.41.1",
    "@spotify/basic-pitch": "1.0.1",
    "@tensorflow/tfjs": "3.21.0",
    "@tensorflow/tfjs-backend-wasm": "3.21.0",
    "@tonejs/midi": "^2.0.28",
    "fast-xml-parser": "^5.3.0",
    "fflate": "^0.8.2",
    "lucide": "^0.468.0",
    "midi-file": "1.2.4",
    "nodemailer": "10.1.7",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "vexflow": "^5.0.0"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.4",
    "jsdom": "24.1.3",
    "typescript": "5.9.3",
    "vite": "^6.4.1"
  },
  "overrides": {
    "@tensorflow/tfjs": {
      "argparse": "2.0.1"
    }
  }
}
