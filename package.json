{
  "name": "qinban-piano-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/prepare-assets.mjs && vite build",
    "start": "node server.mjs",
    "launch": "node scripts/launch.mjs",
    "test": "node --test tests/*.test.mjs",
    "ai:check": "node scripts/ai-check.mjs",
    "omr:setup": "node scripts/setup-audiveris.mjs",
    "scores:add": "node scripts/score-repo.mjs add",
    "scores:verify": "node scripts/score-repo.mjs verify",
    "scores:list": "node scripts/score-repo.mjs list",
    "scores:index": "node scripts/score-repo.mjs index"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@neteasecloudmusicapienhanced/api": "4.41.1",
    "@spotify/basic-pitch": "1.0.1",
    "@tensorflow/tfjs": "3.21.0",
    "@tensorflow/tfjs-backend-wasm": "3.21.0",
    "@tonejs/midi": "^2.0.28",
    "fast-xml-parser": "^5.3.0",
    "fflate": "^0.8.2",
    "lucide": "^0.468.0",
    "midi-file": "1.2.4",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "pdfjs-dist": "^6.4.299",
    "vexflow": "^5.0.0"
  },
  "devDependencies": {
    "jsdom": "24.1.3",
    "vite": "^6.4.1"
  },
  "overrides": {
    "@tensorflow/tfjs": {
      "argparse": "2.0.1"
    }
  }
}
