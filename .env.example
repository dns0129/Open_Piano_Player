# Example only. Use process environment or: node --env-file=/private/path/commerce.env scripts/accounts.mjs start
# Do not commit real credentials. All hosted variables are independent of local Pi/Codex login.
QINBAN_ACCOUNT_PROFILE=local
QINBAN_ACCOUNT_PORT=8793
QINBAN_ACCOUNT_DIR=.local/accounts-v1

# Empty key/rates keep paid recognition unavailable. Verify the actual provider model and current prices.
QINBAN_HOSTED_API_KEY=
QINBAN_HOSTED_API_BASE=https://api.openai.com/v1
QINBAN_HOSTED_MODEL=gpt-6.1-sol
QINBAN_HOSTED_INPUT_USD_PER_MILLION=
QINBAN_HOSTED_OUTPUT_USD_PER_MILLION=

# Production/staging: configure privately, apply all db/ numbered migrations with maintenance credentials first.
# QINBAN_ACCOUNT_PROFILE=production
# QINBAN_PUBLIC_ORIGIN=https://your-domain.example
# QINBAN_ACCOUNT_SECRET=
# QINBAN_AUTH_DATABASE_URL=
# QINBAN_LIBRARY_DATABASE_URL=
# QINBAN_SMTP_URL=
# QINBAN_MAIL_FROM=

# iOS uses two independent HTTPS deployments and databases: staging=Sandbox, production=Production.
# Debug/TestFlight/App Review use staging; verified App Store distribution uses production.
# Never reuse account secrets or databases between those deployments.
# QINBAN_ACCOUNT_PROFILE=staging
# QINBAN_APPLE_ENVIRONMENT=Sandbox
# QINBAN_APPLE_BUNDLE_ID=com.yourcompany.qinban
# QINBAN_APPLE_APP_ID=
# QINBAN_APPLE_KEY_ID=
# QINBAN_APPLE_ISSUER_ID=
# QINBAN_APPLE_PRIVATE_KEY_FILE=/private/qinban/AuthKey.p8
# Official Apple root certificates in DER format; never accept client-provided roots.
# QINBAN_APPLE_ROOT_CERT_FILES=["/private/qinban/AppleRootCA-G3.cer"]
# QINBAN_APPLE_PRODUCT_LIGHT=com.yourcompany.qinban.light.monthly
# QINBAN_APPLE_PRODUCT_STANDARD=com.yourcompany.qinban.standard.monthly
# QINBAN_APPLE_PRODUCT_PROFESSIONAL=com.yourcompany.qinban.professional.monthly
# QINBAN_APPLE_PRODUCT_TOPUP=com.yourcompany.qinban.points150

# Public legal/operator information. List actual email, hosting and recognition providers.
# QINBAN_OPERATOR_NAME=
# QINBAN_SUPPORT_EMAIL=
# QINBAN_PRIVACY_PROCESSORS=[{"name":"Actual provider","purpose":"Cloud score recognition","privacyUrl":"https://provider.example/privacy"}]
